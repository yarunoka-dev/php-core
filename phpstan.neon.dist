parameters:
    level: max
    paths:
        - src/
        - tests/
        - tools/
    # Docgen fixtures are parse-only input for the extractor, never loaded code
    excludePaths:
        - tools/docgen/tests/fixtures/
    # PHPUnit and php-parser live in their own vendor-bin namespaces, outside the root autoloader
    bootstrapFiles:
        - vendor-bin/phpunit/vendor/autoload.php
        - vendor-bin/docgen/vendor/autoload.php
